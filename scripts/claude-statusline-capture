#!/usr/bin/env python3
"""Passively collect native Claude Code quota snapshots from statusLine stdin.

Claude owns the rates; this hook never touches OAuth credentials or makes HTTP
requests. Only aggregate quota percentages and reset timestamps are persisted.
"""
import json
import os
import sys
import tempfile
import time
from datetime import datetime

CACHE = os.path.join(
    os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"),
    "caelestia-agent-usage-claude-last-good.json",
)


def reset_epoch(value):
    if isinstance(value, (int, float)) and value > 0:
        return int(value / 1000 if value > 1e11 else value)
    if isinstance(value, str):
        try:
            return int(datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp())
        except ValueError:
            return 0
    return 0


def valid_bucket(bucket):
    if not isinstance(bucket, dict):
        return None
    used = bucket.get("used_percentage")
    if isinstance(used, bool) or not isinstance(used, (int, float)):
        return None
    if not 0 <= used <= 100:
        return None
    return float(used) / 100, reset_epoch(bucket.get("resets_at"))


def read_existing():
    try:
        with open(CACHE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save(value):
    tmp = None
    try:
        directory = os.path.dirname(CACHE)
        os.makedirs(directory, mode=0o700, exist_ok=True)
        fd, tmp = tempfile.mkstemp(prefix=".claude-quota-", dir=directory)
        with os.fdopen(fd, "w") as f:
            json.dump(value, f)
        os.replace(tmp, CACHE)
    except OSError:
        pass
    finally:
        if tmp and os.path.exists(tmp):
            os.unlink(tmp)


def capture(payload):
    limits = payload.get("rate_limits") or {}
    five = valid_bucket(limits.get("five_hour"))
    seven = valid_bucket(limits.get("seven_day"))
    if not five and not seven:
        return None

    old = read_existing()
    reading = old.get("reading") or {}
    reading = dict(reading)
    reading.update({
        "id": "claude",
        "name": "Claude Code",
        "available": True,
        "configured": True,
        "detail": None,
        "source": "claude-statusline",
    })
    now = int(time.time())
    if five:
        reading.update(fiveHour=five[0], fiveHourResets=five[1])
    if seven:
        reading.update(weekly=seven[0], weeklyResets=seven[1])
    reading.setdefault("fiveHour", -1)
    reading.setdefault("weekly", -1)
    reading.setdefault("fiveHourResets", 0)
    reading.setdefault("weeklyResets", 0)
    reading["stale"] = False
    reading["observedAt"] = now
    save({"generated": now, "reading": reading})
    return reading


def main():
    try:
        payload = json.load(sys.stdin)
        result = capture(payload)
        # Keep the native statusline minimal; never print prompts or user data.
        if result:
            bits = []
            for label, key in (("5h", "fiveHour"), ("7d", "weekly")):
                if result[key] >= 0:
                    bits.append(f"{label} {result[key] * 100:.0f}%")
            if bits:
                print(" · ".join(bits))
    except (OSError, ValueError, TypeError):
        pass


if __name__ == "__main__":
    main()
