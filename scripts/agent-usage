#!/usr/bin/env python3
"""Collect the rolling usage limits of the coding agents installed on this
machine and print them as one JSON document.

Every agent reports the same two windows, because that is what all three of
them bill against: a short rolling window (five hours) and a long one (a
week). An agent that is not installed, not signed in, or has not been run
since its last reset is reported as unavailable rather than as zero -- an
empty gauge and a missing gauge are very different things to look at.

Output:

    {
      "generated": 1790000000,
      "agents": [
        {
          "id": "claude", "name": "Claude Code", "available": true,
          "fiveHour": 0.02, "weekly": 0.44,
          "fiveHourResets": 1790000000, "weeklyResets": 1790500000,
          "detail": null, "stale": false
        },
        ...
      ]
    }

Percentages are fractions in 0..1 so the QML side can feed them straight to a
progress bar. `stale` marks a reading recovered from an agent's own on-disk
log rather than from a live query, so the card can say so.
"""

import json
import os
import sys
import time
import glob
import shutil
import subprocess
import urllib.request
import urllib.error
import fcntl
import tempfile
import email.utils

HOME = os.path.expanduser("~")
CACHE = os.path.join(
    os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "caelestia-agent-usage.json"
)

# Long-lived, last successfully observed data. This deliberately survives
# logouts/reboots, unlike the short-lived poll cache under XDG_RUNTIME_DIR.
LAST_GOOD = os.path.join(
    os.environ.get("XDG_CACHE_HOME") or os.path.join(HOME, ".cache"),
    "caelestia-agent-usage-last-good.json",
)

FIVE_HOUR = 300       # minutes
WEEK = 7 * 24 * 60    # minutes


def unavailable(agent_id, name, detail):
    return {
        "id": agent_id,
        "name": name,
        "available": False,
        "fiveHour": -1,
        "weekly": -1,
        "fiveHourResets": 0,
        "weeklyResets": 0,
        "detail": detail,
        "stale": False,
    }


def iso_to_epoch(value):
    if not value:
        return 0
    try:
        from datetime import datetime

        return int(datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp())
    except Exception:
        return 0


# --------------------------------------------------------------------------
# Claude Code -- the OAuth credentials Claude Code itself stores answer the
# same usage endpoint its /usage command reads.
# --------------------------------------------------------------------------

CLAUDE_CREDS = os.path.join(HOME, ".claude", ".credentials.json")
CLAUDE_USAGE_URL = "https://api.anthropic.com/api/oauth/usage"
CLAUDE_TOKEN_URL = "https://platform.claude.com/v1/oauth/token"
# Claude Code is an OAuth public client.  This is its published client id, not
# a secret; it is needed to exchange the refresh token it already keeps.
CLAUDE_CLIENT_ID = "9d1c250a-e61b-44d9-88ed-5944d1962f5e"

CLAUDE_REFRESH_STATE = os.path.join(
    os.environ.get("XDG_RUNTIME_DIR") or "/tmp",
    "caelestia-agent-usage-claude-refresh-state.json",
)
CLAUDE_LAST_GOOD = os.path.join(
    os.environ.get("XDG_CACHE_HOME") or os.path.join(HOME, ".cache"),
    "caelestia-agent-usage-claude-last-good.json",
)


def read_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def private_json(path, value):
    """Write a small private cache atomically without storing OAuth tokens."""
    tmp = None
    try:
        os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
        fd, tmp = tempfile.mkstemp(
            prefix=".agent-usage-", dir=os.path.dirname(path)
        )
        with os.fdopen(fd, "w") as f:
            json.dump(value, f)
        os.replace(tmp, path)
    except OSError:
        pass
    finally:
        if tmp and os.path.exists(tmp):
            os.unlink(tmp)


def refresh_error_status():
    state = read_json(CLAUDE_REFRESH_STATE)
    return (state.get("status") if state.get("retryAfter", 0) > time.time()
            else None)


def delay_claude_refresh(http_error):
    """Respect Retry-After, then exponential backoff across QML poll runs."""
    state = read_json(CLAUDE_REFRESH_STATE)
    attempts = min(6, int(state.get("attempts", 0)) + 1)
    delay = min(1800, 60 * (2 ** attempts))
    header = http_error.headers.get("Retry-After") if http_error.headers else None
    if header:
        try:
            delay = max(delay, float(header))
        except ValueError:
            try:
                until = email.utils.parsedate_to_datetime(header).timestamp()
                delay = max(delay, until - time.time())
            except (TypeError, ValueError, OverflowError):
                pass
    # Non-rate-limit failures should also avoid hot loops.
    private_json(CLAUDE_REFRESH_STATE, {
        "status": int(http_error.code),
        "attempts": attempts,
        "retryAfter": time.time() + max(60, min(delay, 3600)),
    })


def claude_usage_fallback(reason):
    """Use the last known reading, never turning missing data into 0%."""
    previous = read_json(CLAUDE_LAST_GOOD)
    sample = previous.get("reading") or {}
    if sample.get("available"):
        answer = dict(sample)
        answer["stale"] = True
        answer["configured"] = True
        answer["detail"] = reason
        answer["observedAt"] = int(previous.get("generated", 0))
        return answer
    answer = unavailable("claude", "Claude Code", reason)
    # Monitoring availability is not the same thing as CLI availability.
    answer["configured"] = True
    return answer


def refresh_claude_token(oauth):
    """Refresh Claude's OAuth token with the JSON payload its service expects.

    Serialize our own refreshes and re-read the credential file while holding
    the lock. Never overwrite a token another Claude process already rotated.
    """
    try:
        lock_fd = os.open(CLAUDE_CREDS + ".agent-usage.lock",
                          os.O_CREAT | os.O_RDWR, 0o600)
    except OSError:
        return None

    with os.fdopen(lock_fd, "r+") as lock_file:
        fcntl.flock(lock_file, fcntl.LOCK_EX)
        try:
            with open(CLAUDE_CREDS) as f:
                credentials = json.load(f)
        except (OSError, ValueError):
            return None

        current = credentials.get("claudeAiOauth") or {}
        # Another process may already have renewed it since our first read.
        if (current.get("accessToken") and
                current.get("expiresAt", 0) / 1000 > time.time() + 60):
            return current

        refresh = current.get("refreshToken")
        if not refresh:
            return None
        if read_json(CLAUDE_REFRESH_STATE).get("retryAfter", 0) > time.time():
            return None

        # Anthropic's Claude Code token service requires JSON, *not* OAuth
        # form encoding. A form body fails renewal even with valid credentials.
        body = json.dumps({
            "grant_type": "refresh_token",
            "refresh_token": refresh,
            "client_id": CLAUDE_CLIENT_ID,
        }).encode("utf-8")
        req = urllib.request.Request(
            CLAUDE_TOKEN_URL,
            data=body,
            headers={
                "Content-Type": "application/json",
                "Accept": "application/json",
                "User-Agent": "claude-code/2.1.299",
            },
        )
        try:
            with urllib.request.urlopen(req, timeout=8) as response:
                refreshed = json.load(response)
        except urllib.error.HTTPError as e:
            delay_claude_refresh(e)
            return None
        except (OSError, ValueError, urllib.error.URLError):
            return None

        access = refreshed.get("access_token")
        if not access:
            return None

        updated = dict(current)
        updated["accessToken"] = access
        updated["refreshToken"] = refreshed.get("refresh_token") or refresh
        if refreshed.get("expires_in") is not None:
            updated["expiresAt"] = int(
                (time.time() + float(refreshed["expires_in"])) * 1000
            )
        if refreshed.get("refresh_token_expires_in") is not None:
            updated["refreshTokenExpiresAt"] = int(
                (time.time() + float(refreshed["refresh_token_expires_in"])) * 1000
            )

        # Keep the credential-file permissions private. If another writer has
        # already updated the file, do not clobber their newer refresh token.
        tmp = None
        try:
            with open(CLAUDE_CREDS) as f:
                latest = json.load(f)
            if ((latest.get("claudeAiOauth") or {}).get("refreshToken")
                    != refresh):
                return latest.get("claudeAiOauth") or None
            latest["claudeAiOauth"] = updated
            fd, tmp = tempfile.mkstemp(
                prefix=".credentials.agent-usage-", dir=os.path.dirname(CLAUDE_CREDS)
            )
            with os.fdopen(fd, "w") as f:
                json.dump(latest, f)
                f.flush()
                os.fsync(f.fileno())
            os.chmod(tmp, 0o600)
            os.replace(tmp, CLAUDE_CREDS)
        except (OSError, ValueError):
            # A successful refresh still works for this reading; a later poll
            # may have to retry if the disk write was blocked.
            pass
        finally:
            if tmp and os.path.exists(tmp):
                os.unlink(tmp)
        private_json(CLAUDE_REFRESH_STATE, {"status": 0, "retryAfter": 0,
                                           "attempts": 0})
        return updated


def claude(timeout):
    name = "Claude Code"

    try:
        with open(CLAUDE_CREDS) as f:
            oauth = json.load(f).get("claudeAiOauth") or {}
    except FileNotFoundError:
        return unavailable("claude", name, "not installed")
    except Exception as e:
        return unavailable("claude", name, "credentials unreadable")

    token = oauth.get("accessToken")
    if not token:
        return unavailable("claude", name, "not signed in")

    expires = oauth.get("expiresAt")
    if expires and expires / 1000 < time.time():
        oauth = refresh_claude_token(oauth)
        if not oauth:
            # An expired access token is normal.  Keep retrying its still-live
            # refresh token on later polls rather than calling this a sign-out.
            status = refresh_error_status()
            reason = ("Usage rate-limited" if status == 429
                      else "Usage refresh delayed")
            return claude_usage_fallback(reason)
        token = oauth["accessToken"]

    req = urllib.request.Request(
        CLAUDE_USAGE_URL,
        headers={
            "Authorization": "Bearer " + token,
            "anthropic-beta": "oauth-2025-04-20",
            "Content-Type": "application/json",
        },
    )

    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            body = json.load(r)
    except urllib.error.HTTPError as e:
        return claude_usage_fallback(
            "Usage sign-in needed" if e.code in (401, 403)
            else "Usage rate-limited" if e.code == 429
            else "Usage service unavailable"
        )
    except Exception:
        return claude_usage_fallback("Usage service offline")

    short = body.get("five_hour") or {}
    long = body.get("seven_day") or {}

    result = {
        "id": "claude",
        "name": name,
        "available": True,
        "fiveHour": (short.get("utilization") or 0) / 100.0,
        "weekly": (long.get("utilization") or 0) / 100.0,
        "fiveHourResets": iso_to_epoch(short.get("resets_at")),
        "weeklyResets": iso_to_epoch(long.get("resets_at")),
        "detail": None,
        "stale": False,
        "configured": True,
    }
    private_json(CLAUDE_LAST_GOOD, {"generated": int(time.time()),
                                    "reading": result})
    return result


# --------------------------------------------------------------------------
# Codex -- every rollout file carries the rate limits the server returned with
# the last response of that session, so the newest session that has any is the
# most recent reading there is.
# --------------------------------------------------------------------------

CODEX_SESSIONS = os.path.join(HOME, ".codex", "sessions")
CODEX_SCAN = 12  # newest rollout files to look through


def codex(_timeout):
    name = "Codex"

    if not os.path.isdir(CODEX_SESSIONS):
        return unavailable("codex", name, "not installed")

    files = glob.glob(os.path.join(CODEX_SESSIONS, "**", "rollout-*.jsonl"), recursive=True)
    if not files:
        return unavailable("codex", name, "never run")

    files.sort(key=os.path.getmtime, reverse=True)

    best = None
    for path in files[:CODEX_SCAN]:
        reading = _codex_limits(path)
        if reading and (best is None or reading[2] > best[2]):
            best = reading

    if best is None:
        return unavailable("codex", name, "no usage recorded")

    primary, secondary, seen = best
    short = primary if primary.get("window_minutes", 0) <= FIVE_HOUR * 2 else secondary
    long = secondary or primary

    short_pct, short_reset, short_stale = _codex_window(short)
    long_pct, long_reset, long_stale = _codex_window(long)

    return {
        "id": "codex",
        "name": name,
        "available": True,
        "fiveHour": short_pct,
        "weekly": long_pct,
        "fiveHourResets": short_reset,
        "weeklyResets": long_reset,
        "detail": None,
        "stale": short_stale or long_stale or (time.time() - seen > 120),
        "observedAt": int(seen),
    }


def _codex_window(window):
    """One window of a Codex reading, rolled forward if it has since reset."""
    if not window:
        return -1, 0, False

    used = (window.get("used_percent") or 0) / 100.0
    resets = int(window.get("resets_at") or 0)

    # The reading is only ever as old as the last Codex run. Once its own reset
    # time has passed the window has emptied, whatever the recorded figure said.
    if resets and resets < time.time():
        return 0.0, 0, True

    return used, resets, False


def _codex_limits(path):
    """The last rate_limits record in one rollout file, with its own timestamp."""
    try:
        with open(path, errors="replace") as f:
            lines = f.readlines()
    except OSError:
        return None

    for line in reversed(lines):
        if '"rate_limits"' not in line:
            continue
        try:
            entry = json.loads(line)
        except ValueError:
            continue

        limits = _find_key(entry, "rate_limits")
        if not limits:
            continue

        primary = limits.get("primary")
        secondary = limits.get("secondary")
        if not primary and not secondary:
            continue

        seen = iso_to_epoch(entry.get("timestamp")) or os.path.getmtime(path)
        return primary or {}, secondary or {}, seen

    return None


def _find_key(obj, key):
    """rate_limits sits at a different depth across Codex versions."""
    if isinstance(obj, dict):
        if isinstance(obj.get(key), dict):
            return obj[key]
        for value in obj.values():
            found = _find_key(value, key)
            if found:
                return found
    elif isinstance(obj, list):
        for value in obj:
            found = _find_key(value, key)
            if found:
                return found
    return None


# --------------------------------------------------------------------------
# Antigravity -- the agy CLI answers its read-only slash commands in print
# mode, one tab-separated record per line, without spending a turn.
# --------------------------------------------------------------------------

AGY_BIN = os.path.join(HOME, ".local", "bin", "agy")
AGY_POOLS = (
    ("gemini", "Google", "Gemini Models"),
    ("claude-gpt", "Claude / GPT", "Claude and GPT models"),
)


def antigravity(timeout):
    name = "Antigravity"
    stored = (read_json(LAST_GOOD).get("agents") or {}).get("antigravity") or {}
    old_pools = {p.get("id"): p for p in stored.get("pools", [])}
    agy = AGY_BIN if os.access(AGY_BIN, os.X_OK) else shutil.which("agy")
    readings = {}
    problem = None

    if not agy:
        problem = "not installed"
    else:
        try:
            out = subprocess.run(
                [agy, "-p", "/usage"],
                capture_output=True,
                text=True,
                timeout=max(timeout, 20),
            )
            if out.returncode == 0:
                readings = _agy_parse(out.stdout)
                if not readings:
                    problem = "no usage recorded"
            else:
                # A failed /usage request does not prove a sign-out.
                problem = "not answering"
        except (subprocess.TimeoutExpired, OSError):
            problem = "not answering"

    now = int(time.time())
    pools = []
    for pool_id, title, source_name in AGY_POOLS:
        measurements = readings.get(source_name) or {}
        previous = old_pools.get(pool_id) or {}
        values = {}
        observed = []
        used_cache = False

        for key, reset_key in (("fiveHour", "fiveHourResets"),
                               ("weekly", "weeklyResets")):
            if key in measurements:
                values[key], values[reset_key] = measurements[key]
                observed.append(now)
            elif previous.get(key, -1) >= 0:
                values[key] = previous[key]
                values[reset_key] = previous.get(reset_key, 0)
                observed.append(int(previous.get("observedAt") or
                                    stored.get("observedAt") or 0))
                used_cache = True
            else:
                values[key], values[reset_key] = -1, 0

        available = values["fiveHour"] >= 0 or values["weekly"] >= 0
        pools.append({
            "id": pool_id, "name": title,
            "available": available,
            **values,
            "stale": used_cache or not bool(measurements),
            # Oldest measured window determines how stale the row is.
            "observedAt": min(observed) if observed else 0,
            "detail": problem if not measurements else None,
        })

    available = any(p["available"] for p in pools)
    fresh = any(readings.get(name) for _, _, name in AGY_POOLS)
    return {
        "id": "antigravity", "name": name,
        "available": available,
        "configured": bool(agy),
        "fiveHour": max((p["fiveHour"] for p in pools), default=-1),
        "weekly": max((p["weekly"] for p in pools), default=-1),
        "fiveHourResets": 0, "weeklyResets": 0,
        "pools": pools,
        "detail": problem if not fresh else None,
        "stale": any(p["stale"] and p["available"] for p in pools),
        "observedAt": min((p["observedAt"] for p in pools if p["available"]),
                          default=0),
        # No single "Antigravity usage" exists; the two pools are independent.
    }


def _agy_parse(text):
    """{pool: {window: (used fraction, reset epoch)}} out of /usage's records.

    Each record is `<pool>\t<window> Limit Remaining\t<n>%\t<ISO reset>`, and
    it reports what is *left*, which is the opposite of every other agent here.
    """
    pools = {}

    for line in text.splitlines():
        fields = [f.strip() for f in line.split("\t")]
        if len(fields) < 3:
            continue

        pool, label, remaining = fields[0], fields[1], fields[2]
        if not remaining.endswith("%"):
            continue

        if "five hour" in label.lower():
            window = "fiveHour"
        elif "week" in label.lower():
            window = "weekly"
        else:
            continue

        try:
            used = 1 - float(remaining[:-1]) / 100.0
        except ValueError:
            continue

        resets = iso_to_epoch(fields[3]) if len(fields) > 3 else 0
        pools.setdefault(pool, {})[window] = (used, resets)

    return pools




COLLECTORS = [claude, codex, antigravity]


def _known_reading(agent_id, fallback, stored):
    """On a collector outage, retain the observed readings, with provenance."""
    previous = stored.get(agent_id) or {}
    if not previous.get("available"):
        return fallback
    recovered = dict(previous)
    recovered["stale"] = True
    recovered["detail"] = fallback.get("detail") or "Usage refresh unavailable"
    recovered["observedAt"] = int(previous.get("observedAt", 0))
    return recovered


def collect(timeout):
    now = int(time.time())
    stored = read_json(LAST_GOOD).get("agents") or {}
    updated = dict(stored)
    agents = []
    for collector in COLLECTORS:
        try:
            item = collector(timeout)
        except Exception:
            # A broken collector must not make the entire panel disappear.
            ident = {"claude": "Claude Code", "codex": "Codex",
                     "antigravity": "Antigravity"}[collector.__name__]
            item = unavailable(collector.__name__, ident, "usage refresh failed")

        if not item.get("available"):
            item = _known_reading(item["id"], item, stored)

        if item.get("available"):
            # An agent can contain mixed live/cached windows. Preserve the
            # original measurement time for cached data; never re-date it.
            item.setdefault("observedAt", now)
            if not item.get("stale"):
                updated[item["id"]] = item
            elif item["id"] == "antigravity":
                # A fresh Antigravity pool must still be saved even when its
                # sibling pool failed; preserve each cached pool's timestamp.
                fresh = [p for p in item["pools"]
                         if p["available"] and not p["stale"]]
                if fresh:
                    updated[item["id"]] = item
        agents.append(item)

    private_json(LAST_GOOD, {"agents": updated})
    return {"generated": now, "agents": agents}


def cached(max_age):
    if max_age <= 0:
        return None
    try:
        with open(CACHE) as f:
            body = json.load(f)
    except Exception:
        return None
    if time.time() - body.get("generated", 0) > max_age:
        return None
    return body


def store(body):
    try:
        tmp = CACHE + ".tmp"
        with open(tmp, "w") as f:
            json.dump(body, f)
        os.replace(tmp, CACHE)
    except OSError:
        pass


def main():
    args = sys.argv[1:]
    max_age = 0
    timeout = 8

    for i, arg in enumerate(args):
        if arg == "--max-age" and i + 1 < len(args):
            max_age = float(args[i + 1])
        elif arg == "--timeout" and i + 1 < len(args):
            timeout = float(args[i + 1])

    body = cached(max_age)
    if body is None:
        body = collect(timeout)
        store(body)

    json.dump(body, sys.stdout)
    sys.stdout.write("\n")


if __name__ == "__main__":
    main()
